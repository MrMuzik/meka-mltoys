        "ft_ticker_Xt5w": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  .ft-ticker {\n    display: none;\n  }\n  .ft-ticker--placed {\n    display: block;\n    background: #14161a;\n    border-bottom: 4px solid #e11d2a;\n    overflow: hidden;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    transform: translateX(-50%);\n    margin-bottom: 0;\n  }\n  .ft-ticker__track {\n    display: flex;\n    width: max-content;\n    animation: ft-ticker-scroll 28s linear infinite;\n  }\n  .ft-ticker__items {\n    display: flex;\n    align-items: center;\n    padding: 22px 0;\n    white-space: nowrap;\n  }\n  .ft-ticker__item {\n    font-family: 'IBM Plex Sans', sans-serif;\n    font-weight: 400;\n    font-size: 22px;\n    color: #ffffff;\n    letter-spacing: 0.88px;\n    padding: 0 18px;\n    white-space: nowrap;\n  }\n  .ft-ticker__dot {\n    display: inline-block;\n    width: 10px;\n    height: 10px;\n    border-radius: 50%;\n    background: #e11d2a;\n    flex-shrink: 0;\n    margin: 0 18px 0 0;\n  }\n  @keyframes ft-ticker-scroll {\n    from { transform: translateX(0); }\n    to { transform: translateX(-50%); }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .ft-ticker__track { animation: none; }\n  }\n</style>\n<div class=\"ft-ticker\" id=\"ft-ticker\">\n  <div class=\"ft-ticker__track\">\n    <div class=\"ft-ticker__items\">\n      <span class=\"ft-ticker__item\">Upgrade-Ready from Day One</span><span class=\"ft-ticker__dot\"></span>\n      <span class=\"ft-ticker__item\">Rubber All-Terrain Tires</span><span class=\"ft-ticker__dot\"></span>\n      <span class=\"ft-ticker__item\">Fast, Friendly Support</span><span class=\"ft-ticker__dot\"></span>\n      <span class=\"ft-ticker__item\">Exclusively At ML Toys</span><span class=\"ft-ticker__dot\"></span>\n      <span class=\"ft-ticker__item\">Built Stronger. Lasts Longer.</span><span class=\"ft-ticker__dot\"></span>\n    </div>\n    <div class=\"ft-ticker__items\">\n      <span class=\"ft-ticker__item\">Upgrade-Ready from Day One</span><span class=\"ft-ticker__dot\"></span>\n      <span class=\"ft-ticker__item\">Rubber All-Terrain Tires</span><span class=\"ft-ticker__dot\"></span>\n      <span class=\"ft-ticker__item\">Fast, Friendly Support</span><span class=\"ft-ticker__dot\"></span>\n      <span class=\"ft-ticker__item\">Exclusively At ML Toys</span><span class=\"ft-ticker__dot\"></span>\n      <span class=\"ft-ticker__item\">Built Stronger. Lasts Longer.</span><span class=\"ft-ticker__dot\"></span>\n    </div>\n  </div>\n</div>\n<script>\n(function() {\n  function placeTicker() {\n    var ticker = document.getElementById('ft-ticker');\n    var tabs = document.querySelector('.pd-tabs');\n    if (!ticker || !tabs) return;\n    tabs.parentNode.insertBefore(ticker, tabs);\n    ticker.classList.add('ft-ticker--placed');\n  }\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', placeTicker);\n  } else {\n    placeTicker();\n  }\n})();\n</script>"
