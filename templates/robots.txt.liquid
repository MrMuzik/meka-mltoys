{% for group in robots.default_groups %}
  {{- group.user_agent -}}
  {% for rule in group.rules %}
    {{- rule -}}
  {% endfor %}
  {% if group.user_agent == 'User-agent: *' %}
Disallow: /?variant=
  {% endif %}
  {% if group.sitemap != blank %}
    {{- group.sitemap -}}
  {% endif %}

{% endfor %}