<div id="sg-{{ section.id }}" class="sg-wrap">

  <div class="sg-inner">

    {%- comment -%} ── Badge ── {%- endcomment -%}
    <div class="sg-badge" aria-hidden="true">
      <span class="sg-badge__pct">{{ section.settings.badge_pct | default: '100%' }}</span>
      <span class="sg-badge__label">{{ section.settings.badge_label | default: 'GUARANTEE' }}</span>
    </div>

    {%- comment -%} ── Text ── {%- endcomment -%}
    <div class="sg-text">
      {%- if section.settings.headline != blank -%}
        <p class="sg-headline">{{ section.settings.headline }}</p>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="sg-body">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

  </div>

  {%- if section.settings.show_bottom_rip -%}
    <span class="sg-rip sg-rip--bottom">
      <img src="{{ 'sg-rip-bottom.svg' | asset_url }}" alt="" loading="lazy">
    </span>
  {%- endif -%}

</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@500;700&family=IBM+Plex+Sans:wght@700&family=Anton&display=swap');

  #sg-{{ section.id }} {
    position: relative;
    background: #f4efe2;
    z-index: 10;
  }
  @media (min-width: 1025px) and (max-width: 1860px) {
    #sg-{{ section.id }} {
      margin-bottom: {{ section.settings.margin_bottom | default: '0px' }};
    }
  }

  /* ── Inner ── */
  .sg-inner {
    display: flex;
    gap: 32px;
    align-items: center;
    justify-content: center;
    padding: 56px;
    max-width: 1440px;
    margin: 0 auto;
  }

  /* ── Badge ── */
  .sg-badge {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    border-radius: 999px;
    background: #e11d2a;
    border: 4px solid #001429;
    box-shadow: 32px 24px 60px -12px rgba(0,20,41,0.55), -3px 8px 0px 0px #001429;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: #ffffff;
    white-space: nowrap;
  }
  .sg-badge__pct {
    font-family: 'Anton', sans-serif;
    font-size: 38px;
    line-height: 1;
  }
  .sg-badge__label {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 9px;
    letter-spacing: 1.08px;
    text-transform: uppercase;
  }

  /* ── Text ── */
  .sg-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 820px;
  }
  .sg-headline {
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 700;
    font-size: 32px;
    letter-spacing: 0.32px;
    color: #0b0c0e;
    margin: 0;
    white-space: nowrap;
  }
  .sg-body {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.5;
    color: #2a2d33;
    margin: 0;
  }

  /* ── Bottom rip ── */
  .sg-rip {
    display: block;
    width: 100%;
    line-height: 0;
    font-size: 0;
    position: relative;
    overflow: hidden;
  }
  .sg-rip--bottom::before {
    content: '';
    position: absolute;
    inset: 0;
    background: {{ section.settings.bottom_rip_bg | default: '#f4efe2' }};
    z-index: 0;
    height: 80px;
    bottom: 0;
    top: calc(100% - 80px);
  }
  .sg-rip img {
    display: block;
    width: 100%;
    height: auto;
    position: relative;
    z-index: 1;
  }
  @media (max-width: 1024px) {
    .sg-rip { display: none; }
  }
  @media (min-width: 1861px) {
    .sg-rip { display: none; }
  }

  /* ── Responsive ── */
  @media (max-width: 749px) {
    .sg-inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 40px 20px;
      gap: 24px;
    }
    .sg-headline { white-space: normal; font-size: 26px; }
  }
</style>

{% schema %}
{
  "name": "Guarantee Bar",
  "tag": "section",
  "class": "sg-section",
  "settings": [
    { "type": "header",   "content": "Badge" },
    { "type": "text",     "id": "badge_pct",   "label": "Percentage",   "default": "100%" },
    { "type": "text",     "id": "badge_label", "label": "Badge label",  "default": "GUARANTEE" },
    { "type": "header",   "content": "Text" },
    { "type": "text",     "id": "headline",    "label": "Headline",     "default": "We Stand Behind Every Vehicle." },
    { "type": "textarea", "id": "body",        "label": "Body",         "default": "If something isn't right, we'll make it right. That's the deal, backed by US-based ML Toys support and a parts catalog that's stocked and ready to ship." },
    { "type": "header",   "content": "Ripped paper edge" },
    { "type": "checkbox", "id": "show_bottom_rip",  "label": "Show bottom rip",                "default": true },
    { "type": "color",    "id": "bottom_rip_bg",    "label": "Bottom rip — background color",  "default": "#f4efe2", "info": "Match this to the background color of the section directly below." },
    { "type": "text",     "id": "margin_bottom",    "label": "Bottom margin / overlap",        "default": "-150px", "info": "Use a negative value (e.g. -150px) to pull the rip into the section below and absorb the extra spacing." }
  ],
  "presets": [
    {
      "name": "Guarantee Bar"
    }
  ]
}
{% endschema %}
