<div id="srv-{{ section.id }}" class="srv-wrap">

  <div class="srv-inner">

    {%- comment -%} ── Zone 1: Header ── {%- endcomment -%}
    <div class="srv-head">

      {%- comment -%} Left: Eyebrow + Headline ── {%- endcomment -%}
      <div class="srv-head__left">
        {%- if section.settings.eyebrow != blank -%}
          <p class="srv-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.headline != blank -%}
          <h2 class="srv-headline">{{ section.settings.headline }}</h2>
        {%- endif -%}
      </div>

      {%- comment -%} Right: Rating summary card ── {%- endcomment -%}
      <div class="srv-card">

        <div class="srv-card__summary">
          <p class="srv-card__score">{{ product.metafields.judge_me.rating | default: '—' }}</p>
          <p class="srv-card__stars" data-jm-stars>★★★★★</p>
          <p class="srv-card__count"><span data-jm-count>{{ product.metafields.judge_me.rating_count | default: '—' }}</span> reviews</p>
        </div>

        <div class="srv-card__bars">
          {%- for i in (1..5) -%}
            {%- assign star = 6 | minus: i -%}
            <div class="srv-bar-row">
              <span class="srv-bar-row__label">{{ star }}★</span>
              <div class="srv-bar-row__track">
                <div class="srv-bar-row__fill" data-star="{{ star }}" style="width: 0%"></div>
              </div>
              <span class="srv-bar-row__pct" data-star-pct="{{ star }}">—</span>
            </div>
          {%- endfor -%}
        </div>

      </div>
    </div>

    {%- comment -%} ── Filter pills ── {%- endcomment -%}
    <div class="srv-filters" role="group" aria-label="Filter reviews">
      <button class="srv-pill srv-pill--active" data-filter="all">ALL REVIEWS</button>
      <button class="srv-pill" data-filter="verified">VERIFIED ONLY</button>
      <button class="srv-pill" data-filter="5">5★</button>
      <button class="srv-pill" data-filter="4">4★</button>
      <button class="srv-pill" data-filter="photos">WITH PHOTOS</button>
      <button class="srv-pill" data-filter="upgrades">MENTIONS UPGRADES</button>
      <button class="srv-pill" data-filter="support">MENTIONS SUPPORT</button>
    </div>

    {%- comment -%} ── Zone 2: Judge.me widget (shown when filter = all) ── {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="srv-reviews srv-reviews--jm">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Zone 2b: Custom filtered review list (shown when filter ≠ all) ── {%- endcomment -%}
    <div class="srv-reviews srv-filtered-reviews" style="display:none"></div>

  </div>

</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@500;700&family=IBM+Plex+Sans:wght@700&display=swap');

  /* ── Wrapper ── */
  #srv-{{ section.id }} {
    position: relative;
    background: #ffffff;
    overflow: hidden;
  }

  /* ── Inner ── */
  .srv-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 44px;
    padding: 144px 56px 100px;
    max-width: 1440px;
    margin: 0 auto;
  }

  /* ── Head ── */
  .srv-head {
    display: flex;
    gap: 32px;
    align-items: flex-start;
    width: 100%;
  }
  .srv-head__left {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
  }
  .srv-eyebrow {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 2.52px;
    text-transform: uppercase;
    color: #001429;
    margin: 0;
    white-space: nowrap;
  }
  .srv-headline {
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1;
    letter-spacing: -0.28px;
    color: #0b0c0e;
    margin: 0;
  }

  /* ── Rating card ── */
  .srv-card {
    flex-shrink: 0;
    width: 533px;
    border: 4px solid #001429;
    border-radius: 18px;
    padding: 24px 28px;
    display: flex;
    gap: 28px;
    align-items: flex-start;
    background: #ffffff;
  }
  .srv-card__summary {
    flex-shrink: 0;
    width: 123px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .srv-card__score {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 56px;
    line-height: 1;
    color: #0b0c0e;
    margin: 0;
  }
  .srv-card__stars {
    font-size: 14px;
    color: #e11d2a;
    margin: 0;
    letter-spacing: 2px;
  }
  .srv-card__count {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.88px;
    color: #6b7280;
    margin: 0;
    text-align: center;
  }

  /* ── Breakdown bars ── */
  .srv-card__bars {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .srv-bar-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .srv-bar-row__label {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.44px;
    color: #6b7280;
    width: 20px;
    flex-shrink: 0;
  }
  .srv-bar-row__track {
    flex: 1;
    height: 8px;
    background: #f4efe2;
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }
  .srv-bar-row__fill {
    display: block !important;
    position: absolute;
    top: 0;
    left: 0;
    height: 8px;
    border-radius: 999px;
    background: #e11d2a;
    transition: width 0.6s ease;
  }
  /* Gray fill for 3★ and below */
  .srv-bar-row__fill[data-star="3"],
  .srv-bar-row__fill[data-star="2"],
  .srv-bar-row__fill[data-star="1"] {
    background: #b5bac2;
  }
  .srv-bar-row__pct {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 11px;
    color: #2a2d33;
    width: 28px;
    flex-shrink: 0;
    text-align: right;
  }

  /* ── Filter hide class (must beat JM's !important) ── */
  .srv-reviews .jdgm-rev.srv-hidden { display: none !important; }

  /* ── Filter pills ── */
  .srv-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
  }
  .srv-pill {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.88px;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid #e1dccd;
    background: #ffffff;
    color: #2a2d33;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .srv-pill--active {
    background: #0b0c0e;
    color: #ffffff;
  }

  /* ── Reviews zone ── */
  .srv-reviews {
    width: 100%;
  }

  /* ── Hide Judge.me's duplicate header, summary & sort dropdown ── */
  .srv-reviews .jdgm-rev-widg__header,
  .srv-reviews .jdgm-rev-header,
  .srv-reviews .jdgm-summary,
  .srv-reviews [class*="review-header"],
  .srv-reviews [class*="widget-title"],
  .srv-reviews [class*="widget__title"],
  .srv-reviews [class*="summary"],
  .srv-reviews .jdgm-form,
  .srv-reviews select,
  .srv-reviews .jdgm-revs-filter-and-sort,
  .srv-reviews [class*="filter-and-sort"],
  .srv-reviews [class*="sort"] { display: none !important; }

  /* ── Review card: match Figma layout ── */
  .srv-reviews .jdgm-rev {
    display: flex !important;
    gap: 24px !important;
    align-items: flex-start !important;
    background: #ffffff !important;
    border: 1.5px solid #e1dccd !important;
    border-radius: 18px !important;
    padding: 24px 28px !important;
    margin-bottom: 16px !important;
  }

  /* ── Avatar column ── */
  .srv-reviews .jdgm-rev .jdgm-reviewer-info,
  .srv-reviews .jdgm-rev .jdgm-reviewer {
    flex-shrink: 0 !important;
    width: 120px !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    gap: 6px !important;
    text-align: center !important;
  }
  /* Avatar circle */
  .srv-reviews .jdgm-rev .jdgm-reviewer-icon,
  .srv-reviews .jdgm-rev .jdgm-avatar {
    width: 56px !important;
    height: 56px !important;
    border-radius: 999px !important;
    background: #ffd2ff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-family: 'IBM Plex Sans', sans-serif !important;
    font-weight: 700 !important;
    font-size: 26px !important;
    color: #0b0c0e !important;
    overflow: hidden !important;
    flex-shrink: 0 !important;
  }
  .srv-reviews .jdgm-rev .jdgm-reviewer-name {
    font-family: 'Inter', sans-serif !important;
    font-weight: 700 !important;
    font-size: 13px !important;
    color: #0b0c0e !important;
    text-align: center !important;
  }
  /* Verified badge */
  .srv-reviews .jdgm-rev .jdgm-verified-text,
  .srv-reviews .jdgm-rev .jdgm-badge-check,
  .srv-reviews .jdgm-rev [class*="verified"] {
    font-family: 'Inter', sans-serif !important;
    font-weight: 700 !important;
    font-size: 9px !important;
    letter-spacing: 0.72px !important;
    color: #1e8c4a !important;
    text-transform: uppercase !important;
  }

  /* ── Review body ── */
  .srv-reviews .jdgm-rev .jdgm-review-content,
  .srv-reviews .jdgm-rev .jdgm-rev-body {
    flex: 1 !important;
    min-width: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 10px !important;
  }
  /* Stars + date row */
  .srv-reviews .jdgm-rev .jdgm-review-header-with-date,
  .srv-reviews .jdgm-rev .jdgm-rev-header {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
  }
  .srv-reviews .jdgm-rev .jdgm-star-rating,
  .srv-reviews .jdgm-rev [class*="star"] {
    color: #e11d2a !important;
    font-size: 14px !important;
    letter-spacing: 1px !important;
  }
  .srv-reviews .jdgm-rev .jdgm-review-date,
  .srv-reviews .jdgm-rev .jdgm-rev-date,
  .srv-reviews .jdgm-rev time {
    font-family: 'Inter', sans-serif !important;
    font-weight: 500 !important;
    font-size: 12px !important;
    color: #6b7280 !important;
  }
  /* Review title */
  .srv-reviews .jdgm-rev .jdgm-rev-title,
  .srv-reviews .jdgm-rev .jdgm-review-title {
    font-family: 'Inter', sans-serif !important;
    font-weight: 700 !important;
    font-size: 16px !important;
    letter-spacing: 0.08px !important;
    color: #0b0c0e !important;
  }
  /* Review body text */
  .srv-reviews .jdgm-rev .jdgm-rev-text,
  .srv-reviews .jdgm-rev .jdgm-review__body,
  .srv-reviews .jdgm-rev .jdgm-review-body {
    font-family: 'Inter', sans-serif !important;
    font-weight: 500 !important;
    font-size: 14px !important;
    line-height: 1.6 !important;
    color: #2a2d33 !important;
  }

  /* ── Custom filtered review cards ── */
  .srv-filtered-reviews { display: flex; flex-direction: column; gap: 12px; width: 100%; }
  .srv-frev {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    background: #ffffff;
    border: 1.5px solid #e1dccd;
    border-radius: 18px;
    padding: 24px 28px;
  }
  .srv-frev__av {
    flex-shrink: 0;
    width: 56px; height: 56px;
    border-radius: 999px;
    background: #ffd2ff;
    display: flex; align-items: center; justify-content: center;
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 700; font-size: 26px; color: #0b0c0e;
    overflow: hidden;
  }
  .srv-frev__av img { width: 100%; height: 100%; object-fit: cover; }
  .srv-frev__col { flex-shrink: 0; width: 120px; display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; }
  .srv-frev__name { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 13px; color: #0b0c0e; }
  .srv-frev__verified { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 9px; letter-spacing: 0.72px; color: #1e8c4a; text-transform: uppercase; }
  .srv-frev__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .srv-frev__top { display: flex; align-items: center; gap: 12px; }
  .srv-frev__stars { color: #e11d2a; font-size: 14px; letter-spacing: 1px; }
  .srv-frev__date { font-family: 'Inter', sans-serif; font-weight: 500; font-size: 12px; color: #6b7280; }
  .srv-frev__title { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 16px; color: #0b0c0e; margin: 0; }
  .srv-frev__text { font-family: 'Inter', sans-serif; font-weight: 500; font-size: 14px; line-height: 1.6; color: #2a2d33; margin: 0; }
  .srv-frev__photos { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px; }
  .srv-frev__photos img { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; display: block !important; }
  .srv-filtered-empty { font-family: 'Inter', sans-serif; font-size: 14px; color: #6b7280; padding: 32px; border: 2px dashed #e1dccd; border-radius: 18px; text-align: center; }

  /* ── Responsive ── */
  @media (max-width: 989px) {
    .srv-inner { padding: 100px 32px 80px; }
    .srv-head { flex-direction: column; }
    .srv-card { width: 100%; max-width: 533px; }
  }
  @media (max-width: 749px) {
    .srv-inner { padding: 80px 20px 60px; }
    .srv-card { flex-direction: column; gap: 16px; }
    .srv-card__summary { width: 100%; flex-direction: row; gap: 16px; align-items: center; }
    .srv-card__score { font-size: 40px; }
  }
</style>

<script>
(function() {
  var section = document.getElementById('srv-{{ section.id }}');
  if (!section) return;

  var populated = false;

  function renderStars(score) {
    var full  = Math.floor(score);
    var half  = (score - full) >= 0.4 ? 1 : 0;
    var empty = 5 - full - half;
    return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(empty);
  }

  function tryPopulate() {
    if (populated) return;

    // ── Score & count from Judge.me badge ──
    var badge = document.querySelector('[data-average-rating]');
    var score = badge ? parseFloat(badge.getAttribute('data-average-rating')) : null;
    var total = badge ? parseInt(badge.getAttribute('data-number-of-reviews'), 10) : null;

    if (score) {
      var scoreEl = section.querySelector('.srv-card__score');
      if (scoreEl) scoreEl.textContent = score.toFixed(1);

      var starsEl = section.querySelector('[data-jm-stars]');
      if (starsEl) {
        var full = Math.floor(score + 0.5);
        starsEl.textContent = '★'.repeat(full) + '☆'.repeat(5 - full);
      }
    }
    if (total) {
      var countEl = section.querySelector('[data-jm-count]');
      if (countEl) countEl.textContent = total;
    }

    // ── Bars: read from .jdgm-histogram__row data attributes ──
    var rows = document.querySelectorAll('.jdgm-histogram__row');
    var gotBars = false;

    rows.forEach(function(row) {
      var star  = row.getAttribute('data-rating');
      var pct   = row.getAttribute('data-percentage');
      var count = row.getAttribute('data-frequency');
      if (!star) return;

      var ourFill  = section.querySelector('[data-star="' + star + '"]');
      var ourLabel = section.querySelector('[data-star-pct="' + star + '"]');
      if (ourFill)  { ourFill.style.width = (pct || 0) + '%'; gotBars = true; }
      if (ourLabel) ourLabel.textContent = (count || '0');
    });

    if (gotBars && score) {
      populated = true;
      observer.disconnect();
    }
  }

  function tryWithDelay() {
    tryPopulate();
    if (!populated) setTimeout(tryPopulate, 300);
    if (!populated) setTimeout(tryPopulate, 800);
    if (!populated) setTimeout(tryPopulate, 1500);
  }

  var observer = new MutationObserver(function() { setTimeout(tryPopulate, 100); });
  observer.observe(document.body, { childList: true, subtree: true });

  window.addEventListener('load', tryWithDelay);
  document.addEventListener('jdgm.widget.load', tryWithDelay);
  document.addEventListener('jdgm:all_widgets:load', tryWithDelay);
  setTimeout(tryWithDelay, 500);

  // ── Filter pills — API-based cross-page filtering ──
  var activeFilter = 'all';
  var cachedReviews = null;
  var jmApiToken  = {{ section.settings.jm_api_token | json }};
  var jmShop      = {{ shop.permanent_domain | json }};
  var jmProductId = {{ product.id | json }};
  var jmEl        = section.querySelector('.srv-reviews--jm');
  var filteredEl  = section.querySelector('.srv-filtered-reviews');

  // Debug: inspect JM internals
  setTimeout(function() {
    console.log('[srv-reviews] window.jdgm keys:', window.jdgm ? Object.keys(window.jdgm) : 'NOT FOUND');
    var widgetEl = document.getElementById('judgeme_product_reviews');
    if (widgetEl) {
      console.log('[srv-reviews] widget el keys:', Object.keys(widgetEl).filter(function(k){ return k.startsWith('jdgm') || k.startsWith('__'); }));
      var filterBtns = widgetEl.querySelectorAll('[data-filter], [data-rating], [data-sort], [class*="filter"], [class*="sort"]');
      console.log('[srv-reviews] filter/sort elements inside widget:', filterBtns.length);
      filterBtns.forEach(function(el) { console.log('  -', el.tagName, el.className, JSON.stringify(el.dataset)); });
    }
  }, 3000);

  // Fetch every review from JM API (pages until exhausted)
  function fetchAllReviews(cb) {
    if (cachedReviews) { cb(cachedReviews); return; }
    if (!jmApiToken) { console.warn('[srv-reviews] No API token set'); cb([]); return; }
    // Note: direct API fetch blocked by CORS — this path currently unused
    cb([]); return;
    var all = [], page = 1;
    function next() {
      var url = 'https://judge.me/api/v1/reviews'
        + '?api_token=' + encodeURIComponent(jmApiToken)
        + '&shop_domain=' + encodeURIComponent(jmShop)
        + '&product_id=' + encodeURIComponent(jmProductId)
        + '&per_page=100&page=' + page;
      console.log('[srv-reviews] fetching page', page, url);
      fetch(url)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          console.log('[srv-reviews] page', page, '— reviews returned:', (data.reviews || []).length, '| first review:', data.reviews && data.reviews[0]);
          var chunk = data.reviews || [];
          all = all.concat(chunk);
          if (chunk.length === 100) { page++; next(); }
          else { cachedReviews = all; cb(all); }
        })
        .catch(function(err) { console.error('[srv-reviews] fetch error:', err); cb(all); });
    }
    next();
  }

  function matchesFilter(r) {
    var body = ((r.title || '') + ' ' + (r.body || '')).toLowerCase();
    if (activeFilter === 'verified') return r.reviewer && r.reviewer.verified_buyer;
    if (activeFilter === '5') return r.rating === 5;
    if (activeFilter === '4') return r.rating === 4;
    if (activeFilter === 'photos') return r.pictures && r.pictures.length > 0;
    if (activeFilter === 'upgrades') return /upgrad|motor|battery|speed|volt|amp|watt/.test(body);
    if (activeFilter === 'support') return /support|customer service|helped|help |staff|response|reply|team/.test(body);
    return true;
  }

  function fmtDate(str) {
    try {
      var d = new Date(str);
      return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    } catch(e) { return str; }
  }

  function renderCard(r) {
    var name     = (r.reviewer && r.reviewer.name) || 'Anonymous';
    var initial  = name.charAt(0).toUpperCase();
    var verified = r.reviewer && r.reviewer.verified_buyer;
    var stars    = '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating);
    var date     = fmtDate(r.created_at);
    var photos   = (r.pictures || []).map(function(p) {
      var src = (p.urls && (p.urls.small || p.urls.original)) || p.url || '';
      return src ? '<img src="' + src + '" alt="" loading="lazy">' : '';
    }).join('');
    return '<div class="srv-frev">'
      + '<div class="srv-frev__col">'
      +   '<div class="srv-frev__av">' + initial + '</div>'
      +   '<p class="srv-frev__name">' + name + '</p>'
      +   (verified ? '<p class="srv-frev__verified">✓ VERIFIED</p>' : '')
      + '</div>'
      + '<div class="srv-frev__body">'
      +   '<div class="srv-frev__top"><span class="srv-frev__stars">' + stars + '</span><span class="srv-frev__date">' + date + '</span></div>'
      +   (r.title ? '<p class="srv-frev__title">' + r.title + '</p>' : '')
      +   (r.body  ? '<p class="srv-frev__text">' + r.body  + '</p>' : '')
      +   (photos  ? '<div class="srv-frev__photos">' + photos + '</div>' : '')
      + '</div>'
      + '</div>';
  }

  function showFiltered(reviews) {
    if (!filteredEl) return;
    var matched = reviews.filter(matchesFilter);
    if (!matched.length) {
      // No API data yet — fall back to showing JM widget
      showAll();
      return;
    }
    filteredEl.innerHTML = matched.map(renderCard).join('');
    if (jmEl) jmEl.style.display = 'none';
    filteredEl.style.display = 'flex';
  }

  function showAll() {
    if (jmEl) jmEl.style.display = '';
    if (filteredEl) filteredEl.style.display = 'none';
  }

  // Wire pills
  var pills = section.querySelectorAll('.srv-pill');
  pills.forEach(function(pill) {
    pill.addEventListener('click', function() {
      pills.forEach(function(p) { p.classList.remove('srv-pill--active'); });
      pill.classList.add('srv-pill--active');
      activeFilter = pill.getAttribute('data-filter');

      if (activeFilter === 'all') {
        showAll();
      } else {
        fetchAllReviews(showFiltered);
      }
    });
  });

  // Pre-fetch in the background so first filter click is instant
  window.addEventListener('load', function() {
    setTimeout(function() { fetchAllReviews(function() {}); }, 2000);
  });
})();
</script>

