<div id="srv-{{ section.id }}" class="srv-wrap">

  <div class="srv-inner">

    {%- comment -%} ── Zone 1: Header ── {%- endcomment -%}
    <div class="srv-head">

      {%- comment -%} Left: Eyebrow + Headline ── {%- endcomment -%}
      <div class="srv-head__left">
        {%- if section.settings.eyebrow != blank -%}
          <p class="srv-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.headline != blank -%}
          <h2 class="srv-headline">{{ section.settings.headline }}</h2>
        {%- endif -%}
      </div>

      {%- comment -%} Right: Rating summary card ── {%- endcomment -%}
      <div class="srv-card">

        <div class="srv-card__summary">
          <p class="srv-card__score">{{ product.metafields.judge_me.rating | default: '—' }}</p>
          <p class="srv-card__stars" data-jm-stars>★★★★★</p>
          <p class="srv-card__count"><span data-jm-count>{{ product.metafields.judge_me.rating_count | default: '—' }}</span> reviews</p>
        </div>

        <div class="srv-card__bars">
          {%- for i in (1..5) -%}
            {%- assign star = 6 | minus: i -%}
            <div class="srv-bar-row">
              <span class="srv-bar-row__label">{{ star }}★</span>
              <div class="srv-bar-row__track">
                <div class="srv-bar-row__fill" data-star="{{ star }}" style="width: 0%"></div>
              </div>
              <span class="srv-bar-row__pct" data-star-pct="{{ star }}">—</span>
            </div>
          {%- endfor -%}
        </div>

      </div>
    </div>

    {%- comment -%} ── Zone 2: App blocks (Judge.me Review Widget goes here) ── {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="srv-reviews">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>

</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@500;700&family=IBM+Plex+Sans:wght@700&display=swap');

  /* ── Wrapper ── */
  #srv-{{ section.id }} {
    position: relative;
    background: #ffffff;
    overflow: hidden;
  }

  /* ── Inner ── */
  .srv-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 44px;
    padding: 144px 56px 100px;
    max-width: 1440px;
    margin: 0 auto;
  }

  /* ── Head ── */
  .srv-head {
    display: flex;
    gap: 32px;
    align-items: flex-start;
    width: 100%;
  }
  .srv-head__left {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
  }
  .srv-eyebrow {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 2.52px;
    text-transform: uppercase;
    color: #001429;
    margin: 0;
    white-space: nowrap;
  }
  .srv-headline {
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1;
    letter-spacing: -0.28px;
    color: #0b0c0e;
    margin: 0;
  }

  /* ── Rating card ── */
  .srv-card {
    flex-shrink: 0;
    width: 533px;
    border: 4px solid #001429;
    border-radius: 18px;
    padding: 24px 28px;
    display: flex;
    gap: 28px;
    align-items: flex-start;
    background: #ffffff;
  }
  .srv-card__summary {
    flex-shrink: 0;
    width: 123px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .srv-card__score {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 56px;
    line-height: 1;
    color: #0b0c0e;
    margin: 0;
  }
  .srv-card__stars {
    font-size: 14px;
    color: #e11d2a;
    margin: 0;
    letter-spacing: 2px;
  }
  .srv-card__count {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.88px;
    color: #6b7280;
    margin: 0;
    text-align: center;
  }

  /* ── Breakdown bars ── */
  .srv-card__bars {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .srv-bar-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .srv-bar-row__label {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.44px;
    color: #6b7280;
    width: 20px;
    flex-shrink: 0;
  }
  .srv-bar-row__track {
    flex: 1;
    height: 8px;
    background: #f4efe2;
    border-radius: 999px;
    overflow: hidden;
  }
  .srv-bar-row__fill {
    height: 100%;
    border-radius: 999px;
    background: #e11d2a;
    transition: width 0.6s ease;
  }
  /* Gray fill for 3★ and below */
  .srv-bar-row__fill[data-star="3"],
  .srv-bar-row__fill[data-star="2"],
  .srv-bar-row__fill[data-star="1"] {
    background: #b5bac2;
  }
  .srv-bar-row__pct {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 11px;
    color: #2a2d33;
    width: 28px;
    flex-shrink: 0;
    text-align: right;
  }

  /* ── Reviews zone ── */
  .srv-reviews {
    width: 100%;
  }
  .srv-jm-notice {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #6b7280;
    padding: 32px;
    border: 2px dashed #e1dccd;
    border-radius: 18px;
    text-align: center;
    margin: 0;
  }

  /* ── Hide Judge.me's duplicate header & summary in Zone 2 ── */
  .srv-reviews .jdgm-rev-widg__header,
  .srv-reviews .jdgm-review-header,
  .srv-reviews .jdgm-summary,
  .srv-reviews [class*="review-header"],
  .srv-reviews [class*="widget-title"],
  .srv-reviews [class*="widget__title"],
  .srv-reviews [class*="summary"] { display: none !important; }

  /* ── Judge.me widget base resets ── */
  .srv-reviews .jdgm-widget { font-family: 'Inter', sans-serif !important; }
  .srv-reviews .jdgm-review { border-bottom: 1px solid #e1dccd !important; padding: 24px 0 !important; }
  .srv-reviews .jdgm-reviewer-name { font-weight: 700 !important; color: #0b0c0e !important; }
  .srv-reviews .jdgm-review__timestamp { color: #6b7280 !important; font-size: 12px !important; }
  .srv-reviews .jdgm-review__body { color: #2a2d33 !important; font-size: 15px !important; line-height: 1.6 !important; }
  .srv-reviews .jdgm-star-rating { color: #e11d2a !important; }

  /* ── Responsive ── */
  @media (max-width: 989px) {
    .srv-inner { padding: 100px 32px 80px; }
    .srv-head { flex-direction: column; }
    .srv-card { width: 100%; max-width: 533px; }
  }
  @media (max-width: 749px) {
    .srv-inner { padding: 80px 20px 60px; }
    .srv-card { flex-direction: column; gap: 16px; }
    .srv-card__summary { width: 100%; flex-direction: row; gap: 16px; align-items: center; }
    .srv-card__score { font-size: 40px; }
  }
</style>

<script>
(function() {
  var section = document.getElementById('srv-{{ section.id }}');
  if (!section) return;

  var populated = false;

  function renderStars(score) {
    var full  = Math.floor(score);
    var half  = (score - full) >= 0.4 ? 1 : 0;
    var empty = 5 - full - half;
    return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(empty);
  }

  function tryPopulate() {
    if (populated) return;

    // ── Score & count from Judge.me badge ──
    var badge = document.querySelector('[data-average-rating]');
    var score = badge ? parseFloat(badge.getAttribute('data-average-rating')) : null;
    var total = badge ? parseInt(badge.getAttribute('data-number-of-reviews'), 10) : null;

    if (score) {
      var scoreEl = section.querySelector('.srv-card__score');
      if (scoreEl) scoreEl.textContent = score.toFixed(1);

      var starsEl = section.querySelector('[data-jm-stars]');
      if (starsEl) {
        var full = Math.floor(score + 0.5);
        starsEl.textContent = '★'.repeat(full) + '☆'.repeat(5 - full);
      }
    }
    if (total) {
      var countEl = section.querySelector('[data-jm-count]');
      if (countEl) countEl.textContent = total;
    }

    // ── Bars: exact selector from DevTools ──
    // Structure: .jdgm-histogram > div (row) > .jdgm-histogram__bar > div (fill with width style)
    var rows = document.querySelectorAll('.jdgm-histogram > div');
    var gotBars = false;

    rows.forEach(function(row) {
      // Star label: first link or first text node with a digit + "star"
      var labelEl = row.querySelector('a') || row.firstElementChild;
      var labelText = labelEl ? labelEl.textContent : row.textContent;
      var starMatch = labelText.match(/(\d)\s*star/i);
      if (!starMatch) return;
      var star = starMatch[1];

      // Fill div: .jdgm-histogram__bar > div carries the inline width
      var fillDiv = row.querySelector('.jdgm-histogram__bar > div, .jdgm-histogram__bar div');
      var pct = 0;
      if (fillDiv) {
        var w = (fillDiv.style.width || '').match(/(\d+(?:\.\d+)?)/);
        pct = w ? Math.round(parseFloat(w[1])) : 0;
      }

      // Count: last standalone number in row text (exclude the star digit)
      var allNums = (row.textContent || '').match(/\d+/g) || [];
      var countNums = allNums.filter(function(n) { return parseInt(n, 10) !== parseInt(star, 10); });
      var count = countNums.length ? parseInt(countNums[countNums.length - 1], 10) : null;
      var rowPct = (total && count != null) ? Math.round((count / total) * 100) : pct;

      var ourFill  = section.querySelector('[data-star="' + star + '"]');
      var ourLabel = section.querySelector('[data-star-pct="' + star + '"]');
      if (ourFill)  { ourFill.style.width = rowPct + '%'; gotBars = true; }
      if (ourLabel) ourLabel.textContent = rowPct + '%';
    });

    if (gotBars && score) {
      populated = true;
      observer.disconnect();
    }
  }

  function tryWithDelay() {
    tryPopulate();
    if (!populated) setTimeout(tryPopulate, 300);
    if (!populated) setTimeout(tryPopulate, 800);
    if (!populated) setTimeout(tryPopulate, 1500);
  }

  var observer = new MutationObserver(function() { setTimeout(tryPopulate, 100); });
  observer.observe(document.body, { childList: true, subtree: true });

  window.addEventListener('load', tryWithDelay);
  document.addEventListener('jdgm.widget.load', tryWithDelay);
  document.addEventListener('jdgm:all_widgets:load', tryWithDelay);
  setTimeout(tryWithDelay, 500);
})();
</script>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "srv-section",
  "settings": [
    { "type": "header",   "content": "Head" },
    { "type": "text",     "id": "eyebrow",      "label": "Eyebrow",   "default": "CUSTOMER REVIEWS" },
    { "type": "textarea", "id": "headline",     "label": "Headline",  "default": "From The Families Who Already Own One." },
    { "type": "header",   "content": "Judge.me Integration" },
    { "type": "text", "id": "jm_api_token", "label": "Judge.me Public API Token", "info": "Found in your Judge.me dashboard → Settings → API. Safe to use on the storefront." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [
    {
      "name": "Reviews"
    }
  ]
}
{% endschema %}
