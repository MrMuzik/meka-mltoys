{%- comment -%}
SNIPPET: product-tabs
Usage:
  {% render 'product-tabs', product: product %}

Assumes:
- Description: product.description (always shown)
- Before You Buy: product.metafields.custom.before_you_buy (rich text)
- HOW TO: product.metafields.custom.how_tos (metaobject reference(s) to type `how_to`; One or List)
  Fields on each how_to:
    title (text)
    thumbnail (image file)  -> used as the YouTube poster
    youtube_url (url)
    description (rich text)
    pdf (file)              -> single File reference
    pdf_title (text) OR pdf_file_name (text) -> preferred link text
- FAQs: product.metafields.custom.faqs (list of metaobject refs with question/answer)
{%- endcomment -%}

{%- liquid
  assign before_you_buy_value = product.metafields.custom.before_you_buy.value

  assign has_before_you_buy = false
  if before_you_buy_value != blank
    assign has_before_you_buy = true
  endif

  assign howtos_value = product.metafields.custom.how_tos.value

  assign has_howto = false
  if howtos_value != blank
    for _ in howtos_value
      assign has_howto = true
      break
    endfor
  endif

  assign faqs_field = product.metafields.custom.faqs
  assign has_faqs = false
  if faqs_field != blank
    assign has_faqs = true
  endif

  assign witb_value = product.metafields.custom.whats_in_the_box.value
  assign has_witb = false
  if witb_value != blank
    assign has_witb = true
  endif

  assign specs_value = product.metafields.custom.spec_categories.value
  assign has_specs = false
  if specs_value != blank
    for _ in specs_value
      assign has_specs = true
      break
    endfor
  endif

  assign byb_sections_value = product.metafields.custom.before_you_buy_sections.value
  assign has_byb_sections = false
  if byb_sections_value != blank
    for _ in byb_sections_value
      assign has_byb_sections = true
      break
    endfor
  endif

  assign tab_id = 'pd-tabs-' | append: product.id
-%}

<div class="pd-tabs" id="{{ tab_id }}">
  <input class="pd-tabs__radio" type="radio" name="{{ tab_id }}-rad" id="{{ tab_id }}-desc" checked>
  {%- if has_specs -%}
    <input class="pd-tabs__radio" type="radio" name="{{ tab_id }}-rad" id="{{ tab_id }}-specs">
  {%- endif -%}
  {%- if has_howto -%}
    <input class="pd-tabs__radio" type="radio" name="{{ tab_id }}-rad" id="{{ tab_id }}-howto">
  {%- endif -%}
  {%- if has_before_you_buy or has_byb_sections -%}
    <input class="pd-tabs__radio" type="radio" name="{{ tab_id }}-rad" id="{{ tab_id }}-beforeyoubuy">
  {%- endif -%}
  {%- if has_faqs -%}
    <input class="pd-tabs__radio" type="radio" name="{{ tab_id }}-rad" id="{{ tab_id }}-faqs">
  {%- endif -%}

  <slideshow-component class="slider-mobile-gutter pd-tabs__nav-wrap" data-tabs-slider>
    <button
      type="button"
      class="slider-button ml-button-primary slider-button--prev pd-tabs__nav-btn"
      name="previous"
      aria-label="{{ 'general.slider.previous_slide' | t }}"
      hidden
    >
      {% render 'icon-arrow-short' %}
    </button>

    <div
      id="Tabs-{{ tab_id }}"
      class="pd-tabs__nav pd-tabs__nav--slider slider slider--everywhere"
      role="tablist"
      aria-label="Product information tabs"
    >
      <label class="pd-tabs__btn slider__slide is-active" for="{{ tab_id }}-desc" role="tab" aria-controls="{{ tab_id }}-panel-desc">Description</label>

      {%- if has_specs -%}
        <label class="pd-tabs__btn slider__slide" for="{{ tab_id }}-specs" role="tab" aria-controls="{{ tab_id }}-panel-specs">SPECS</label>
      {%- endif -%}

      {%- if has_howto -%}
        <label class="pd-tabs__btn slider__slide" for="{{ tab_id }}-howto" role="tab" aria-controls="{{ tab_id }}-panel-howto">INSTALLATION INSTRUCTIONS</label>
      {%- endif -%}

      {%- if has_before_you_buy or has_byb_sections -%}
        <label class="pd-tabs__btn slider__slide" for="{{ tab_id }}-beforeyoubuy" role="tab" aria-controls="{{ tab_id }}-panel-beforeyoubuy">BEFORE YOU BUY</label>
      {%- endif -%}

      {%- if has_faqs -%}
        <label class="pd-tabs__btn slider__slide" for="{{ tab_id }}-faqs" role="tab" aria-controls="{{ tab_id }}-panel-faqs">FAQs</label>
      {%- endif -%}
    </div>

    <button
      type="button"
      class="slider-button ml-button-primary slider-button--next pd-tabs__nav-btn"
      name="next"
      aria-label="{{ 'general.slider.next_slide' | t }}"
      hidden
    >
      {% render 'icon-arrow-short' %}
    </button>
  </slideshow-component>

  <div class="pd-tabs__panels">
    <!-- Description -->
    <section class="pd-tabs__panel" id="{{ tab_id }}-panel-desc" role="tabpanel" aria-labelledby="{{ tab_id }}-desc">
      <div class="pd-desc-wrap{% if has_witb %} pd-desc-wrap--with-card{% endif %}">
        <div class="rte pd-desc-body">{{ product.description }}</div>
        {%- if has_witb -%}
          <aside class="pd-witb-card">
            <h3 class="pd-witb-card__title">WHAT'S IN THE BOX</h3>
            <div class="rte pd-witb-card__body">{{ product.metafields.custom.whats_in_the_box | metafield_tag }}</div>
          </aside>
        {%- endif -%}
      </div>
    </section>

    {%- if has_specs -%}
      <section class="pd-tabs__panel" id="{{ tab_id }}-panel-specs" role="tabpanel" aria-labelledby="{{ tab_id }}-specs">
        <div class="pd-specs">
          {%- for cat in specs_value -%}
            {%- assign cat_name = cat.category_name | default: cat.fields.category_name -%}
            {%- assign cat_entries = cat.specs.value | default: cat.fields.specs.value -%}
            <div class="pd-specs__category">
              {%- if cat_name != blank -%}
                <h3 class="pd-specs__cat-title">{{ cat_name }}</h3>
              {%- endif -%}
              {%- if cat_entries != blank -%}
                <dl class="pd-specs__grid">
                  {%- for entry in cat_entries -%}
                    {%- assign entry_key = entry.key | default: entry.fields.key -%}
                    {%- assign entry_val = entry.value | default: entry.fields.value -%}
                    <div class="pd-specs__row">
                      <dt class="pd-specs__key">{{ entry_key }}</dt>
                      <dd class="pd-specs__val">{{ entry_val }}</dd>
                    </div>
                  {%- endfor -%}
                </dl>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- if has_howto -%}
      <section class="pd-tabs__panel" id="{{ tab_id }}-panel-howto" role="tabpanel" aria-labelledby="{{ tab_id }}-howto">
        <div class="howto-list">
          {%- for how in howtos_value -%}
            {%- assign _title = how.title | default: how.fields.title -%}
            {%- assign _thumb = how.thumbnail | default: how.fields.thumbnail -%}
            {%- assign _yt    = how.youtube_url | default: how.fields.youtube_url -%}
            {%- assign _desc  = how.description | default: how.fields.description -%}
            {%- assign _pdf   = how.pdf | default: how.fields.pdf -%}
            {%- assign _pdf_title = how.pdf_title | default: how.fields.pdf_title | default: how.pdf_file_name | default: how.fields.pdf_file_name -%}

            <article class="howto" role="article">
              {%- if _title != blank -%}
                <h3 class="howto-title">{{ _title | escape }}</h3>
              {%- endif -%}

              {%- assign yt = _yt | to_s -%}
              {%- if yt != blank -%}
                {%- assign id = yt -%}
                {%- assign id = id | replace: 'https://youtu.be/', '' | replace: 'http://youtu.be/', '' -%}
                {%- assign id = id | replace: 'https://www.youtube.com/watch?v=', '' | replace: 'http://www.youtube.com/watch?v=', '' -%}
                {%- assign id = id | replace: 'https://youtube.com/watch?v=', '' | replace: 'http://youtube.com/watch?v=', '' -%}
                {%- assign id = id | replace: 'https://www.youtube.com/embed/', '' | replace: 'http://www.youtube.com/embed/', '' -%}
                {%- assign id = id | split: '?' | first | split: '&' | first -%}

                {%- if _thumb -%}
                  <div class="howto-video howto-video--poster" data-yt="{{ id | escape }}">
                    <img class="howto-video__poster" src="{{ _thumb | image_url: width: 1600 }}" alt="{{ _title | escape }}">
                    <button class="howto-video__play" type="button" aria-label="Play video">▶</button>
                  </div>
                {%- else -%}
                  <div class="howto-video">
                    <iframe
                      src="https://www.youtube-nocookie.com/embed/{{ id | escape }}"
                      title="YouTube video player"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen></iframe>
                  </div>
                {%- endif -%}
              {%- endif -%}

              {%- if _desc != blank -%}
                <div class="howto-desc rte">{{ _desc | metafield_tag }}</div>
              {%- endif -%}

              {%- if _pdf -%}
                {%- assign pdf_url = _pdf | file_url -%}
                {%- assign filename_guess = pdf_url | split: '/' | last | split: '?' | first -%}
                {%- assign pdf_label = _pdf_title | default: _title | default: filename_guess -%}
                <p class="howto-pdf">
                  <a href="{{ pdf_url }}" target="_blank" rel="noopener">{{ pdf_label | escape }}</a>
                </p>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- if has_byb_sections or has_before_you_buy -%}
      <section class="pd-tabs__panel" id="{{ tab_id }}-panel-beforeyoubuy" role="tabpanel" aria-labelledby="{{ tab_id }}-beforeyoubuy">
        {%- if has_byb_sections -%}
          {%- comment -%} New structured card layout {%- endcomment -%}
          <div class="pd-byb-cards">
            {%- for card in byb_sections_value -%}
              {%- assign card_title = card.title | default: card.fields.title -%}
              {%- assign card_body  = card.body  | default: card.fields.body -%}
              {%- assign card_num   = forloop.index | prepend: '0' | slice: -2, 2 -%}
              <div class="pd-byb-card">
                <span class="pd-byb-card__num">{{ card_num }}</span>
                {%- if card_title != blank -%}
                  <h3 class="pd-byb-card__title">{{ card_title }}</h3>
                {%- endif -%}
                {%- if card_body != blank -%}
                  <div class="rte pd-byb-card__body">{{ card_body | metafield_tag }}</div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- elsif has_before_you_buy -%}
          {%- comment -%} Legacy rich text fallback {%- endcomment -%}
          <div class="rte">
            {{ product.metafields.custom.before_you_buy | metafield_tag }}
          </div>
        {%- endif -%}
      </section>
    {%- endif -%}

    {%- comment -%} --- FAQs panel --- {%- endcomment -%}
    {%- assign faqs_list = faqs_field.value | default: faqs_field.references -%}
    {%- if faqs_field != blank -%}
      <section class="pd-tabs__panel" id="{{ tab_id }}-panel-faqs" role="tabpanel" aria-labelledby="{{ tab_id }}-faqs">
        <div class="faq-accordion" role="list">
          {%- if faqs_list -%}
            {%- for entry in faqs_list -%}
              {%- assign q_text = '' -%}
              {%- if entry.question -%}{%- assign q_text = entry.question.value | default: entry.question -%}
              {%- elsif entry.fields and entry.fields.question -%}{%- assign q_text = entry.fields.question.value | default: entry.fields.question -%}{%- endif -%}

              <details class="faq">
                <summary class="faq__q">
                  {{ q_text }}
                  <span class="faq__icon" aria-hidden="true">▾</span>
                </summary>
                <div class="faq__a rte">
                  {%- if entry.answer -%}{{ entry.answer | metafield_tag }}
                  {%- elsif entry.fields and entry.fields.answer -%}{{ entry.fields.answer | metafield_tag }}{%- endif -%}
                </div>
              </details>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </section>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var START_OFFSET = window.matchMedia('(max-width: 768px)').matches ? 0 : 40;

    function initPdTabs(root) {
      if (!root || root.dataset.pdTabsInit === '1') return;
      root.dataset.pdTabsInit = '1';

      // -------- Active tab class (works for all navs in this root) --------
      function setActiveFromChecked() {
        var checked = root.querySelector('.pd-tabs__radio:checked');
        if (!checked) return;

        var id = checked.id;
        root.querySelectorAll('.pd-tabs__nav').forEach(function (nav) {
          nav.querySelectorAll('.pd-tabs__btn').forEach(function (lbl) {
            lbl.classList.toggle('is-active', lbl.getAttribute('for') === id);
          });
        });
      }

      setActiveFromChecked();
      root.addEventListener('change', function (e) {
        if (e.target && e.target.classList && e.target.classList.contains('pd-tabs__radio')) {
          setActiveFromChecked();
        }
      });

      // -------- HOW-TO click-to-play posters --------
      root.querySelectorAll('.howto-video--poster').forEach(function (box) {
        // prevent double binding
        if (box.dataset.pdHowtoInit === '1') return;
        box.dataset.pdHowtoInit = '1';

        var id = box.getAttribute('data-yt');
        if (!id) return;

        var btn = box.querySelector('.howto-video__play');

        function activate() {
          if (!box.classList.contains('howto-video--poster')) return;

          var iframe = document.createElement('iframe');
          iframe.setAttribute('allowfullscreen', '');
          iframe.setAttribute('title', 'YouTube video player');
          iframe.setAttribute(
            'allow',
            'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
          );
          iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1';

          box.innerHTML = '';
          box.classList.remove('howto-video--poster');
          box.appendChild(iframe);
        }

        box.addEventListener('click', activate);
        if (btn) {
          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            activate();
          });
        }
      });

      // -------- Tabs slider (supports multiple wraps inside the same root) --------
      var wraps = root.querySelectorAll('[data-tabs-slider]');
      if (!wraps.length) return;

      wraps.forEach(function (wrap) {
        if (wrap.dataset.pdTabsSliderInit === '1') return;
        wrap.dataset.pdTabsSliderInit = '1';

        var track = wrap.querySelector('.pd-tabs__nav');
        if (!track) return;

        var prev = wrap.querySelector('[name="previous"]');
        var next = wrap.querySelector('[name="next"]');

        function hasOverflow(el) {
          return el.scrollWidth > (el.clientWidth + 2);
        }

        function hasClippedRight() {
          var trackRect = track.getBoundingClientRect();
          var tabs = track.querySelectorAll('.pd-tabs__btn');
          for (var i = 0; i < tabs.length; i++) {
            if (tabs[i].getBoundingClientRect().right > trackRect.right + 1) return true;
          }
          return false;
        }

        function hasClippedLeft() {
          var trackRect = track.getBoundingClientRect();
          var tabs = track.querySelectorAll('.pd-tabs__btn');
          for (var i = tabs.length - 1; i >= 0; i--) {
            if (tabs[i].getBoundingClientRect().left < trackRect.left - 1) return true;
          }
          return false;
        }

        function setBtnState(btn, isDisabled) {
          if (!btn) return;
          btn.disabled = !!isDisabled;
          btn.setAttribute('aria-disabled', isDisabled ? 'true' : 'false');
        }

        function update() {
          var overflow = hasOverflow(track);
          var count = track.querySelectorAll('.pd-tabs__btn').length;

          if (prev) prev.hidden = !overflow;
          if (next) next.hidden = !overflow;

          wrap.classList.toggle('pd-tabs__nav-wrap--overflow', overflow);
          wrap.classList.toggle('pd-tabs__nav-wrap--no-overflow', !overflow);

          wrap.classList.toggle('pd-tabs--count-1', !overflow && count === 1);
          wrap.classList.toggle('pd-tabs--count-2-3', !overflow && (count === 2 || count === 3));
          wrap.classList.toggle('pd-tabs--count-4plus', !overflow && count >= 4);

          if (!overflow) {
            // In no-overflow mode, keep "visual start" and disable arrows
            track.scrollLeft = START_OFFSET;
            setBtnState(prev, true);
            setBtnState(next, true);
            return;
          }

          // overflow: clamp and disable at ends
          if (track.scrollLeft < START_OFFSET) track.scrollLeft = START_OFFSET;
          setBtnState(prev, !hasClippedLeft());
          setBtnState(next, !hasClippedRight());
        }

        function scrollByStep(direction) {
          if (direction < 0 && (prev && prev.disabled)) return;
          if (direction > 0 && (next && next.disabled)) return;

          if (track.scrollLeft < START_OFFSET) track.scrollLeft = START_OFFSET;

          var trackRect = track.getBoundingClientRect();
          var tabs = Array.prototype.slice.call(track.querySelectorAll('.pd-tabs__btn'));
          if (!tabs.length) return;

          var target = null;

          if (direction > 0) {
            // first tab clipped on right
            for (var i = 0; i < tabs.length; i++) {
              var r = tabs[i].getBoundingClientRect();
              if (r.right > trackRect.right + 1) { target = tabs[i]; break; }
            }
          } else {
            // last tab clipped on left
            for (var j = tabs.length - 1; j >= 0; j--) {
              var l = tabs[j].getBoundingClientRect();
              if (l.left < trackRect.left - 1) { target = tabs[j]; break; }
            }
          }

          if (!target) return;

          var EDGE_PAD = 12; // breathing room inside the viewport

          // Compute scrollLeft needed to fully reveal the target (prefer aligning right edge)
          var desired;
          if (direction > 0) {
            // Make target's RIGHT edge visible
            desired = (target.offsetLeft + target.offsetWidth) - track.clientWidth + EDGE_PAD;
          } else {
            // Make target's LEFT edge visible
            desired = target.offsetLeft - EDGE_PAD;
          }

          // Clamp
          var visibleW = trackRect.width;
          var maxScroll = track.scrollWidth - visibleW;     
          desired = Math.max(START_OFFSET, desired);
          desired = Math.min(maxScroll, desired);

          // TEMP disable snap so the animation doesn't bounce back
          var prevSnapType = track.style.scrollSnapType;
          track.style.scrollSnapType = 'none';

          track.scrollTo({ left: desired, behavior: 'smooth' });

          // Re-enable snap after scroll settles
          setTimeout(function () {
            track.style.scrollSnapType = prevSnapType || '';
            if (track.scrollLeft < START_OFFSET) track.scrollLeft = START_OFFSET;
            update();
          }, 450);
        }

        if (prev) prev.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          scrollByStep(-1);
        });

        if (next) next.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          scrollByStep(1);
        });

        // Don’t auto-center tabs; only bring into view if clipped
        track.addEventListener('click', function (e) {
          var btn = e.target.closest('.pd-tabs__btn');
          if (!btn) return;
          if (!wrap.classList.contains('pd-tabs__nav-wrap--overflow')) return;

          var trackRect = track.getBoundingClientRect();
          var btnRect = btn.getBoundingClientRect();
          var clippedLeft = btnRect.left < trackRect.left;
          var clippedRight = btnRect.right > trackRect.right;

          if (clippedLeft || clippedRight) {
            btn.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
            setTimeout(update, 180);
            setTimeout(update, 400);
          }
        });

        track.addEventListener('scroll', function () {
          window.requestAnimationFrame(update);
        }, { passive: true });

        // establish baseline
        track.scrollLeft = START_OFFSET;

        update();
        window.addEventListener('resize', update, { passive: true });
        setTimeout(update, 250);
        setTimeout(update, 1000);
      });
    }

    function scanAndInit() {
      document.querySelectorAll('.pd-tabs').forEach(initPdTabs);
    }

    // Run now
    scanAndInit();

    // Shopify section re-renders (theme editor + some dynamic sections)
    document.addEventListener('shopify:section:load', scanAndInit);
    document.addEventListener('shopify:section:reorder', scanAndInit);

    // Catch AJAX/quick-view injections
    var mo = new MutationObserver(function (mutations) {
      for (var i = 0; i < mutations.length; i++) {
        var m = mutations[i];
        for (var j = 0; j < m.addedNodes.length; j++) {
          var node = m.addedNodes[j];
          if (!node || node.nodeType !== 1) continue;

          if (node.classList && node.classList.contains('pd-tabs')) {
            initPdTabs(node);
          } else if (node.querySelectorAll) {
            node.querySelectorAll('.pd-tabs').forEach(initPdTabs);
          }
        }
      }
    });

    mo.observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>

<style>
  /* ===== Product Tabs (scoped by ID) ===== */
  #{{ tab_id }} .pd-tabs__radio { position: absolute; opacity: 0; pointer-events: none; }
  /* NAV: default (desktop/tablet) */
  #{{ tab_id }} .pd-tabs__nav {
    display: flex;
    gap: 2rem;
    align-items: flex-end;
    padding: 0;
    padding-bottom: 8px;
    border-bottom: 2px solid #001429;
    justify-content: start;
  }
  /* Make buttons never shrink weirdly */
  #{{ tab_id }} .pd-tabs__btn {
    position: relative;
    padding: .5rem 3rem;
    padding-bottom: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .02em;
    cursor: pointer;
    opacity: .7;
    flex: 0 0 auto;
    white-space: nowrap;
  }
  #{{ tab_id }} .pd-tabs__btn::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: currentColor;
    opacity: 0; transform: scaleX(0); transition: transform .2s ease, opacity .2s ease;
  }

  #{{ tab_id }} .pd-tabs__btn.is-active::after,
  #{{ tab_id }} .pd-tabs__btn:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  #{{ tab_id }} #{{ tab_id }}-desc:checked  ~ .pd-tabs__nav label[for="{{ tab_id }}-desc"],
  #{{ tab_id }} #{{ tab_id }}-specs:checked ~ .pd-tabs__nav label[for="{{ tab_id }}-specs"],
  #{{ tab_id }} #{{ tab_id }}-howto:checked ~ .pd-tabs__nav label[for="{{ tab_id }}-howto"],
  #{{ tab_id }} #{{ tab_id }}-beforeyoubuy:checked ~ .pd-tabs__nav label[for="{{ tab_id }}-beforeyoubuy"],
  #{{ tab_id }} #{{ tab_id }}-faqs:checked  ~ .pd-tabs__nav label[for="{{ tab_id }}-faqs"] { opacity: 1; color: #C12726; }

  #{{ tab_id }} #{{ tab_id }}-desc:checked  ~ .pd-tabs__nav label[for="{{ tab_id }}-desc"]::after,
  #{{ tab_id }} #{{ tab_id }}-specs:checked ~ .pd-tabs__nav label[for="{{ tab_id }}-specs"]::after,
  #{{ tab_id }} #{{ tab_id }}-howto:checked ~ .pd-tabs__nav label[for="{{ tab_id }}-howto"]::after,
  #{{ tab_id }} #{{ tab_id }}-beforeyoubuy:checked ~ .pd-tabs__nav label[for="{{ tab_id }}-beforeyoubuy"]::after,
  #{{ tab_id }} #{{ tab_id }}-faqs:checked  ~ .pd-tabs__nav label[for="{{ tab_id }}-faqs"]::after { opacity: 1; transform: scaleX(1); }

  #{{ tab_id }} #{{ tab_id }}-desc:hover  ~ .pd-tabs__nav label[for="{{ tab_id }}-desc"],
  #{{ tab_id }} #{{ tab_id }}-specs:hover ~ .pd-tabs__nav label[for="{{ tab_id }}-specs"],
  #{{ tab_id }} #{{ tab_id }}-howto:hover ~ .pd-tabs__nav label[for="{{ tab_id }}-howto"],
  #{{ tab_id }} #{{ tab_id }}-beforeyoubuy:hover ~ .pd-tabs__nav label[for="{{ tab_id }}-beforeyoubuy"],
