{%- comment -%}
SNIPPET: product-tabs
Usage:
  {% render 'product-tabs', product: product %}

Assumes:
- Description: product.description (always shown)
- Before You Buy: product.metafields.custom.before_you_buy (rich text)
- HOW TO: product.metafields.custom.how_tos (metaobject reference(s) to type `how_to`; One or List)
  Fields on each how_to:
    title (text)
    thumbnail (image file)  -> used as the YouTube poster
    youtube_url (url)
    description (rich text)
    pdf (file)              -> single File reference
    pdf_title (text) OR pdf_file_name (text) -> preferred link text
- FAQs: product.metafields.custom.faqs (list of metaobject refs with question/answer)
{%- endcomment -%}

{%- liquid
  assign before_you_buy_value = product.metafields.custom.before_you_buy.value

  assign has_before_you_buy = false
  if before_you_buy_value != blank
    assign has_before_you_buy = true
  endif

  assign howtos_value = product.metafields.custom.how_tos.value

  assign has_howto = false
  if howtos_value != blank
    for _ in howtos_value
      assign has_howto = true
      break
    endfor
  endif

  assign faqs_field = product.metafields.custom.faqs
  assign has_faqs = false
  if faqs_field != blank
    assign has_faqs = true
  endif

  assign tab_id = 'pd-tabs-' | append: product.id
-%}

<div class="pd-tabs" id="{{ tab_id }}">
  <input class="pd-tabs__radio" type="radio" name="{{ tab_id }}-rad" id="{{ tab_id }}-desc" checked>
  {%- if has_howto -%}
    <input class="pd-tabs__radio" type="radio" name="{{ tab_id }}-rad" id="{{ tab_id }}-howto">
  {%- endif -%}
  {%- if has_before_you_buy -%}
    <input class="pd-tabs__radio" type="radio" name="{{ tab_id }}-rad" id="{{ tab_id }}-beforeyoubuy">
  {%- endif -%}
  {%- if has_faqs -%}
    <input class="pd-tabs__radio" type="radio" name="{{ tab_id }}-rad" id="{{ tab_id }}-faqs">
  {%- endif -%}

  <slideshow-component class="slider-mobile-gutter pd-tabs__nav-wrap" data-tabs-slider>
    <button
      type="button"
      class="slider-button ml-button-primary slider-button--prev pd-tabs__nav-btn"
      name="previous"
      aria-label="{{ 'general.slider.previous_slide' | t }}"
      hidden
    >
      {% render 'icon-arrow-short' %}
    </button>

    <div
      id="Tabs-{{ tab_id }}"
      class="pd-tabs__nav pd-tabs__nav--slider slider slider--everywhere"
      role="tablist"
      aria-label="Product information tabs"
    >
      <label class="pd-tabs__btn slider__slide is-active" for="{{ tab_id }}-desc" role="tab" aria-controls="{{ tab_id }}-panel-desc">Description</label>

      {%- if has_howto -%}
        <label class="pd-tabs__btn slider__slide" for="{{ tab_id }}-howto" role="tab" aria-controls="{{ tab_id }}-panel-howto">INSTALLATION INSTRUCTIONS</label>
      {%- endif -%}

      {%- if has_before_you_buy -%}
        <label class="pd-tabs__btn slider__slide" for="{{ tab_id }}-beforeyoubuy" role="tab" aria-controls="{{ tab_id }}-panel-beforeyoubuy">BEFORE YOU BUY</label>
      {%- endif -%}

      {%- if has_faqs -%}
        <label class="pd-tabs__btn slider__slide" for="{{ tab_id }}-faqs" role="tab" aria-controls="{{ tab_id }}-panel-faqs">FAQs</label>
      {%- endif -%}
    </div>

    <button
      type="button"
      class="slider-button ml-button-primary slider-button--next pd-tabs__nav-btn"
      name="next"
      aria-label="{{ 'general.slider.next_slide' | t }}"
      hidden
    >
      {% render 'icon-arrow-short' %}
    </button>
  </slideshow-component>

  <div class="pd-tabs__panels">
    <!-- Description -->
    <section class="pd-tabs__panel" id="{{ tab_id }}-panel-desc" role="tabpanel" aria-labelledby="{{ tab_id }}-desc">
      <div class="rte">{{ product.description }}</div>
    </section>

    {%- if has_howto -%}
      <section class="pd-tabs__panel" id="{{ tab_id }}-panel-howto" role="tabpanel" aria-labelledby="{{ tab_id }}-howto">
        <div class="howto-list">
          {%- for how in howtos_value -%}
            {%- assign _title = how.title | default: how.fields.title -%}
            {%- assign _thumb = how.thumbnail | default: how.fields.thumbnail -%}
            {%- assign _yt    = how.youtube_url | default: how.fields.youtube_url -%}
            {%- assign _desc  = how.description | default: how.fields.description -%}
            {%- assign _pdf   = how.pdf | default: how.fields.pdf -%}
            {%- assign _pdf_title = how.pdf_title | default: how.fields.pdf_title | default: how.pdf_file_name | default: how.fields.pdf_file_name -%}

            <article class="howto" role="article">
              {%- if _title != blank -%}
                <h3 class="howto-title">{{ _title | escape }}</h3>
              {%- endif -%}

              {%- assign yt = _yt | to_s -%}
              {%- if yt != blank -%}
                {%- assign id = yt -%}
                {%- assign id = id | replace: 'https://youtu.be/', '' | replace: 'http://youtu.be/', '' -%}
                {%- assign id = id | replace: 'https://www.youtube.com/watch?v=', '' | replace: 'http://www.youtube.com/watch?v=', '' -%}
                {%- assign id = id | replace: 'https://youtube.com/watch?v=', '' | replace: 'http://youtube.com/watch?v=', '' -%}
                {%- assign id = id | replace: 'https://www.youtube.com/embed/', '' | replace: 'http://www.youtube.com/embed/', '' -%}
                {%- assign id = id | split: '?' | first | split: '&' | first -%}

                {%- if _thumb -%}
                  <div class="howto-video howto-video--poster" data-yt="{{ id | escape }}">
                    <img class="howto-video__poster" src="{{ _thumb | image_url: width: 1600 }}" alt="{{ _title | escape }}">
                    <button class="howto-video__play" type="button" aria-label="Play video">▶</button>
                  </div>
                {%- else -%}
                  <div class="howto-video">
                    <iframe
                      src="https://www.youtube-nocookie.com/embed/{{ id | escape }}"
                      title="YouTube video player"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen></iframe>
                  </div>
                {%- endif -%}
              {%- endif -%}

              {%- if _desc != blank -%}
                <div class="howto-desc rte">{{ _desc | metafield_tag }}</div>
              {%- endif -%}

              {%- if _pdf -%}
                {%- assign pdf_url = _pdf | file_url -%}
                {%- assign filename_guess = pdf_url | split: '/' | last | split: '?' | first -%}
                {%- assign pdf_label = _pdf_title | default: _title | default: filename_guess -%}
                <p class="howto-pdf">
                  <a href="{{ pdf_url }}" target="_blank" rel="noopener">{{ pdf_label | escape }}</a>
                </p>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>

        <script>
          (function () {
            var root = document.getElementById('{{ tab_id }}');
            if (!root) return;

            /* =========================
              1) Tabs nav slider (only when overflow)
              ========================= */
            (function initTabsSlider() {
              var START_OFFSET = 40; // treat this as "scrollLeft = 0" visually
              var wrap = root.querySelector('[data-tabs-slider]');
              var track = root.querySelector('#Tabs-{{ tab_id }}');
              if (!wrap || !track) return;

              var prev = wrap.querySelector('[name="previous"]');
              var next = wrap.querySelector('[name="next"]');

              function hasOverflow(el) {
                return el.scrollWidth > (el.clientWidth + 2);
              }

              function atStart(el) {
                return el.scrollLeft <= (START_OFFSET + 1);
              }

              function atEnd(el) {
                return el.scrollLeft + el.clientWidth >= el.scrollWidth - 1;
              }

              function setBtnState(btn, isDisabled) {
                if (!btn) return;
                btn.disabled = !!isDisabled;
                btn.setAttribute('aria-disabled', isDisabled ? 'true' : 'false');
              }

              function update() {
                var overflow = hasOverflow(track);

                // Count tabs (labels)
                var count = track.querySelectorAll('.pd-tabs__btn').length;

                // Show/hide buttons based on overflow
                if (prev) prev.hidden = !overflow;
                if (next) next.hidden = !overflow;

                // Overflow state (slider mode)
                wrap.classList.toggle('pd-tabs__nav-wrap--overflow', overflow);

                // No-overflow state (distribution mode)
                wrap.classList.toggle('pd-tabs__nav-wrap--no-overflow', !overflow);

                // Count-based distribution classes (only meaningful when NOT overflowing)
                wrap.classList.toggle('pd-tabs--count-1', !overflow && count === 1);
                wrap.classList.toggle('pd-tabs--count-2-3', !overflow && (count === 2 || count === 3));
                wrap.classList.toggle('pd-tabs--count-4plus', !overflow && count >= 4);

                // If no overflow, snap to "visual start" and disable both
                if (!overflow) {
                  track.scrollLeft = START_OFFSET;
                  setBtnState(prev, true);
                  setBtnState(next, true);
                  return;
                }

                // Overflow: clamp to floor so "visual start" acts like 0
                if (track.scrollLeft < START_OFFSET) {
                  track.scrollLeft = START_OFFSET;
                }

                // Overflow: disable buttons based on current scroll position
                setBtnState(prev, atStart(track));
                setBtnState(next, atEnd(track));
              }

              function scrollByStep(direction) {
                // Hard-stop if disabled (prevents the "Description shifts to center" issue)
                if (direction < 0 && (prev && prev.disabled)) return;
                if (direction > 0 && (next && next.disabled)) return;

                // Step by one tab width (fallback 200)
                var slide = track.querySelector('.pd-tabs__btn');
                var step = slide ? slide.getBoundingClientRect().width : 200;

                track.scrollBy({ left: direction * step, behavior: 'smooth' });

                // Disabled state should update after scrolling settles
                setTimeout(update, 180);
                setTimeout(update, 400);
              }

              if (prev) prev.addEventListener('click', function () { scrollByStep(-1); });
              if (next) next.addEventListener('click', function () { scrollByStep(1); });

              // Only scroll a clicked tab into view if it's clipped (don't auto-center)
              track.addEventListener('click', function (e) {
                var btn = e.target.closest('.pd-tabs__btn');
                if (!btn) return;
                if (!wrap.classList.contains('pd-tabs__nav-wrap--overflow')) return;

                var trackRect = track.getBoundingClientRect();
                var btnRect = btn.getBoundingClientRect();

                var clippedLeft = btnRect.left < trackRect.left;
                var clippedRight = btnRect.right > trackRect.right;

                if (clippedLeft || clippedRight) {
                  btn.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
                  setTimeout(update, 180);
                  setTimeout(update, 400);
                }
              });

              // Keep button states accurate as user swipes/scrolls
              track.addEventListener('scroll', function () {
                // throttle-ish without overthinking it
                window.requestAnimationFrame(update);
              }, { passive: true });

              update();
              window.addEventListener('resize', update, { passive: true });
              setTimeout(update, 250);
              setTimeout(update, 1000);
            })();

            /* =========================
              2) HOW-TO click-to-play posters
              ========================= */
            (function initHowtoPosters() {
              var posters = root.querySelectorAll('.howto-video--poster');
              if (!posters.length) return;

              posters.forEach(function (box) {
                var id = box.getAttribute('data-yt');
                if (!id) return;

                var btn = box.querySelector('.howto-video__play');

                var activate = function () {
                  // Prevent double-activation if already swapped
                  if (!box.classList.contains('howto-video--poster')) return;

                  var iframe = document.createElement('iframe');
                  iframe.setAttribute('allowfullscreen', '');
                  iframe.setAttribute('title', 'YouTube video player');
                  iframe.setAttribute(
                    'allow',
                    'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
                  );
                  iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1';

                  box.innerHTML = '';
                  box.classList.remove('howto-video--poster');
                  box.appendChild(iframe);
                };

                box.addEventListener('click', activate);
                if (btn) {
                  btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    activate();
                  });
                }
              });
            })();
            (function initActiveTabClass() {
              var nav = root.querySelector('#Tabs-{{ tab_id }}');
              if (!nav) return;

              var labels = Array.prototype.slice.call(nav.querySelectorAll('.pd-tabs__btn'));
              if (!labels.length) return;

              function setActiveFromChecked() {
                var checked = root.querySelector('.pd-tabs__radio:checked');
                if (!checked) return;

                var id = checked.id; // e.g. "{{ tab_id }}-desc"
                labels.forEach(function (lbl) {
                  lbl.classList.toggle('is-active', lbl.getAttribute('for') === id);
                });
              }

              // On load
              setActiveFromChecked();

              // When any radio changes
              root.addEventListener('change', function (e) {
                if (e.target && e.target.classList && e.target.classList.contains('pd-tabs__radio')) {
                  setActiveFromChecked();
                }
              });
            })();
          })();
        </script>
      </section>
    {%- endif -%}

    {%- if has_before_you_buy -%}
      <section class="pd-tabs__panel" id="{{ tab_id }}-panel-beforeyoubuy" role="tabpanel" aria-labelledby="{{ tab_id }}-beforeyoubuy">
        <div class="rte">
          {{ product.metafields.custom.before_you_buy | metafield_tag }}
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} --- FAQs panel --- {%- endcomment -%}
    {%- assign faqs_list = faqs_field.value | default: faqs_field.references -%}
    {%- if faqs_field != blank -%}
      <section class="pd-tabs__panel" id="{{ tab_id }}-panel-faqs" role="tabpanel" aria-labelledby="{{ tab_id }}-faqs">
        <div class="faq-accordion" role="list">
          {%- if faqs_list -%}
            {%- for entry in faqs_list -%}
              {%- assign q_text = '' -%}
              {%- if entry.question -%}{%- assign q_text = entry.question.value | default: entry.question -%}
              {%- elsif entry.fields and entry.fields.question -%}{%- assign q_text = entry.fields.question.value | default: entry.fields.question -%}{%- endif -%}

              <details class="faq">
                <summary class="faq__q">
                  {{ q_text }}
                  <span class="faq__icon" aria-hidden="true">▾</span>
                </summary>
                <div class="faq__a rte">
                  {%- if entry.answer -%}{{ entry.answer | metafield_tag }}
                  {%- elsif entry.fields and entry.fields.answer -%}{{ entry.fields.answer | metafield_tag }}{%- endif -%}
                </div>
              </details>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </section>
    {%- endif -%}
  </div>
</div>

<style>
  /* ===== Product Tabs (scoped by ID) ===== */
  #{{ tab_id }} .pd-tabs__radio { position: absolute; opacity: 0; pointer-events: none; }
  /* NAV: default (desktop/tablet) */
  #{{ tab_id }} .pd-tabs__nav {
    display: flex;
    gap: 2rem;
    align-items: flex-end;
    padding: 0;
    padding-bottom: 8px;
    border-bottom: 2px solid #001429;
    justify-content: start;
  }
  /* Make buttons never shrink weirdly */
  #{{ tab_id }} .pd-tabs__btn {
    position: relative;
    padding: .5rem 3rem;
    padding-bottom: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .02em;
    cursor: pointer;
    opacity: .7;
    flex: 0 0 auto;
    white-space: nowrap;
  }
  #{{ tab_id }} .pd-tabs__btn::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: currentColor;
    opacity: 0; transform: scaleX(0); transition: transform .2s ease, opacity .2s ease;
  }

  #{{ tab_id }} .pd-tabs__btn.is-active::after,
  #{{ tab_id }} .pd-tabs__btn:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  #{{ tab_id }} #{{ tab_id }}-desc:checked  ~ .pd-tabs__nav label[for="{{ tab_id }}-desc"],
  #{{ tab_id }} #{{ tab_id }}-howto:checked ~ .pd-tabs__nav label[for="{{ tab_id }}-howto"],
  #{{ tab_id }} #{{ tab_id }}-beforeyoubuy:checked ~ .pd-tabs__nav label[for="{{ tab_id }}-beforeyoubuy"],
  #{{ tab_id }} #{{ tab_id }}-faqs:checked  ~ .pd-tabs__nav label[for="{{ tab_id }}-faqs"] { opacity: 1; color: #C12726; }

  #{{ tab_id }} #{{ tab_id }}-desc:checked  ~ .pd-tabs__nav label[for="{{ tab_id }}-desc"]::after,
  #{{ tab_id }} #{{ tab_id }}-howto:checked ~ .pd-tabs__nav label[for="{{ tab_id }}-howto"]::after,
  #{{ tab_id }} #{{ tab_id }}-beforeyoubuy:checked ~ .pd-tabs__nav label[for="{{ tab_id }}-beforeyoubuy"]::after,
  #{{ tab_id }} #{{ tab_id }}-faqs:checked  ~ .pd-tabs__nav label[for="{{ tab_id }}-faqs"]::after { opacity: 1; transform: scaleX(1); }

  #{{ tab_id }} #{{ tab_id }}-desc:hover  ~ .pd-tabs__nav label[for="{{ tab_id }}-desc"],
  #{{ tab_id }} #{{ tab_id }}-howto:hover ~ .pd-tabs__nav label[for="{{ tab_id }}-howto"],
  #{{ tab_id }} #{{ tab_id }}-beforeyoubuy:hover ~ .pd-tabs__nav label[for="{{ tab_id }}-beforeyoubuy"],
  #{{ tab_id }} #{{ tab_id }}-faqs:hover  ~ .pd-tabs__nav label[for="{{ tab_id }}-faqs"] { opacity: 1; }

  #{{ tab_id }} #{{ tab_id }}-desc:hover  ~ .pd-tabs__nav label[for="{{ tab_id }}-desc"]::after,
  #{{ tab_id }} #{{ tab_id }}-howto:hover ~ .pd-tabs__nav label[for="{{ tab_id }}-howto"]::after,
  #{{ tab_id }} #{{ tab_id }}-beforeyoubuy:hover ~ .pd-tabs__nav label[for="{{ tab_id }}-beforeyoubuy"]::after,
  #{{ tab_id }} #{{ tab_id }}-faqs:hover  ~ .pd-tabs__nav label[for="{{ tab_id }}-faqs"]::after { opacity: 1; transform: scaleX(1); }

  #{{ tab_id }} .pd-tabs__panels { margin-top: 1.25rem; }
  #{{ tab_id }} .pd-tabs__panel { display: none; }

  #{{ tab_id }}-desc:checked  ~ .pd-tabs__panels #{{ tab_id }}-panel-desc,
  #{{ tab_id }}-howto:checked ~ .pd-tabs__panels #{{ tab_id }}-panel-howto,
  #{{ tab_id }}-beforeyoubuy:checked ~ .pd-tabs__panels #{{ tab_id }}-panel-beforeyoubuy,
  #{{ tab_id }}-faqs:checked  ~ .pd-tabs__panels #{{ tab_id }}-panel-faqs  {
    display: block;
    font-size: 16px;
    font-weight: 500;
    line-height: 25px;
    padding: 3rem 2rem 0 2rem;
  }

  summary.faq__q {
    text-transform: uppercase;
    font-size: 20px;
    letter-spacing: .25px;
    padding: 1.5rem 0;
    border-top: 2px solid #eee;
  }

  .faq-accordion .faq:last-child .faq__a {
    border-bottom: 2px solid #eee;
  }

  .faq__a p {
    margin-block-start: 0;
    margin-top: 0;
  }

  .faq-accordion .faq:first-child .faq__q {
    border-top: none;
  }

  /* RTE helpers */
  #{{ tab_id }} .rte iframe { max-width: 100%; width: 100%; height: auto; aspect-ratio: 16/9; }
  #{{ tab_id }} .rte img { max-width: 100%; height: auto; }

  /* HOW-TO GRID */
  #{{ tab_id }} .howto-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 750px) and (max-width: 989px) {
    #{{ tab_id }} .howto-list { grid-template-columns: repeat(2, minmax(0,1fr)); }
  }
  @media (min-width: 990px) {
    #{{ tab_id }} .howto-list { grid-template-columns: repeat(3, minmax(0,1fr)); }
  }

  /* HOW-TO card */
  #{{ tab_id }} .howto { border: 1px solid rgba(0,0,0,.08); border-radius: 12px; padding: 1rem; background: #fff; }
  #{{ tab_id }} .howto-title { margin-bottom: .5rem; }
  #{{ tab_id }} .howto-desc { margin-top: .5rem; }

  /* Video & poster */
  #{{ tab_id }} .howto-video { position: relative; width: 100%; padding-top: 56.25%; border-radius: 10px; overflow: hidden; background: #000; }
  #{{ tab_id }} .howto-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  #{{ tab_id }} .howto-video__poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #{{ tab_id }} .howto-video__play {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
    border: 0; border-radius: 999px; width: 64px; height: 64px; font-size: 24px; line-height: 64px;
    background: rgba(255,255,255,.85); cursor: pointer;
  }

  #{{ tab_id }} .howto-pdf { margin-top: .5rem; }

  /* INLINE slider layout: prev | track | next (no overlap) */
  #{{ tab_id }} .pd-tabs__nav-wrap {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;              /* matches your "align-items: flex-end" feel */
    gap: .5rem;
    border-bottom: 2px solid #001429;
    padding: .75rem 1rem 0 1rem;   /* you can tune this per breakpoint */
  }

  #{{ tab_id }} .pd-tabs__nav {
    border-bottom: 0;              /* border now lives on wrap */
    padding: 0;                    /* padding now lives on wrap */
    margin: 0;
    display: flex;
    gap: 2rem;
    align-items: flex-end;
    justify-content: flex-start;
  }

  /* Buttons: place at left/right when overflow */
  #{{ tab_id }} .pd-tabs__nav-wrap--overflow .pd-tabs__nav-buttons {
    position: absolute;
    inset: 0;
    pointer-events: none; /* so the nav remains clickable */
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 .5rem;
    z-index: 2;
    width: 100%;
  }

  #{{ tab_id }} .pd-tabs__nav-wrap--overflow .pd-tabs__nav-buttons .slider-button {
    margin: 0;
  }

  #{{ tab_id }} .pd-tabs__nav-wrap--overflow .pd-tabs__nav-buttons .slider-button {
    pointer-events: auto; /* re-enable for the buttons */
  }

  /* When overflow, give the track breathing room so tabs don't sit under arrows */
  #{{ tab_id }} .pd-tabs__nav-wrap--overflow .pd-tabs__nav {
    padding-left: 4rem;
    padding-right: 4rem;
  }

  /* Make the nav behave like a slider track */
  #{{ tab_id }} .pd-tabs__nav--slider {
    overflow-x: auto;
    overflow-y: hidden;
    white-space: nowrap;
    flex-wrap: nowrap;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
  }

  /* Ensure slides size to content (labels) */
  #{{ tab_id }} .pd-tabs__nav--slider .slider__slide {
    width: auto;
  }

  #{{ tab_id }} .pd-tabs__nav-btn {
    align-self: center;
  }

  #{{ tab_id }} .pd-tabs__nav-btn[disabled],
  #{{ tab_id }} .pd-tabs__nav-btn[aria-disabled="true"] {
    cursor: not-allowed;
  }

  #{{ tab_id }} .pd-tabs__nav-btn[disabled]:hover .icon,
  #{{ tab_id }} .pd-tabs__nav-btn[aria-disabled="true"]:hover .icon {
    color: #fff;
  }

  /* When there is NO overflow, collapse the grid so it feels like a normal tab bar */
  #{{ tab_id }} .pd-tabs__nav-wrap:not(.pd-tabs__nav-wrap--overflow) {
    grid-template-columns: 1fr;
  }
  #{{ tab_id }} .pd-tabs__nav-wrap:not(.pd-tabs__nav-wrap--overflow) .pd-tabs__nav-btn {
    display: none; /* extra safety if hidden attr gets funky */
  }

  #{{ tab_id }} .pd-tabs__btn.is-active {
    opacity: 1;
    color: #C12726;
  }

  /* Default: your tab row */
  #{{ tab_id }} .pd-tabs__nav {
    justify-content: flex-start; /* baseline for overflow mode (scrolling) */
  }

  /* When NOT overflowing, distribute tabs based on count */
  #{{ tab_id }} .pd-tabs__nav-wrap.pd-tabs__nav-wrap--no-overflow .pd-tabs__nav {
